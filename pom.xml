<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- [JAVA8_TO_17_SPECIFIC_DEPENDENCY_UPDATES / JAVA8_TO_21_SPRING_BOOT_COMPATIBILITY]
         Upgraded Spring Boot parent from 2.7.18 to 3.2.5 which:
         - Supports Java 17 as minimum baseline
         - Migrates from javax.* to jakarta.* packages (Spring Boot 3.x uses Jakarta EE 10)
         - Provides updated managed dependency versions compatible with Java 17 -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.2.5</version>
        <relativePath/> <!-- lookup parent from repository -->
    </parent>

    <groupId>com.demo</groupId>
    <artifactId>resortsLite</artifactId>
    <version>1.0.0</version>
    <name>ResortsLite</name>
    <description>Resort booking demo — Java 17 / Spring Boot 3.2.x</description>

    <properties>
        <!-- [JAVA8_TO_17_LOMBOK_CONFIGURATION / JAVA8_TO_21_DEPENDENCY_UPDATES]
             Updated java.version from 1.8 to 17 to target Java 17 compilation.
             This also drives maven-compiler-plugin source/target settings via Spring Boot parent. -->
        <java.version>17</java.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jdbc</artifactId>
        </dependency>

        <!-- [JAVA8_TO_17_SPECIFIC_DEPENDENCY_UPDATES]
             Updated log4j-core from 2.14.1 (CVE-2021-44228 Log4Shell) to 2.21.1
             which is compatible with Java 17 and free of known critical CVEs. -->
        <dependency>
            <groupId>org.apache.logging.log4j</groupId>
            <artifactId>log4j-core</artifactId>
            <version>2.21.1</version>
        </dependency>

        <!-- [JAVA8_TO_17_SPECIFIC_DEPENDENCY_UPDATES]
             Updated commons-collections from 3.2.1 (CVE-2015-6420 RCE) to 3.2.2
             which contains the security fix and is compatible with Java 17. -->
        <dependency>
            <groupId>commons-collections</groupId>
            <artifactId>commons-collections</artifactId>
            <version>3.2.2</version>
        </dependency>

        <!-- [DB_MIGRATION_POSTGRESQL]: Replaced H2 in-memory database with PostgreSQL 16
             JDBC driver. H2 is not suitable for production use and does not support
             PostgreSQL-specific SQL syntax, functions, or data types.
             PostgreSQL driver version 42.7.3 is the latest stable release compatible
             with PostgreSQL 16 and Java 17. -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <version>42.7.3</version>
            <scope>runtime</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- [JAVA8_TO_17_MAVEN_PLUGIN_UPDATES / JAVA8_TO_17_LOMBOK_CONFIGURATION]
                 Added explicit maven-compiler-plugin 3.11.0 configuration:
                 - Updated source/target from 1.8 to 17
                 - Version 3.11.0+ is required for proper Java 17 annotation processing
                 - Enables --release flag support for strict cross-compilation checks -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.11.0</version>
                <configuration>
                    <source>17</source>
                    <target>17</target>
                    <release>17</release>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>

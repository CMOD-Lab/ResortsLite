<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <!-- Updated from 2.7.15 to 3.2.5 for full Java 17 compatibility and Jakarta EE support
             (JAVA8_TO_21_SPRING_BOOT_COMPATIBILITY) -->
        <version>3.2.5</version>
        <relativePath/>
    </parent>

    <groupId>com.demo</groupId>
    <artifactId>resortsLite</artifactId>
    <version>1.0.0</version>
    <name>ResortsLite</name>
    <description>Resort booking demo — Java 17 / Spring Boot 3.2.x</description>

    <properties>
        <!-- Updated from 1.8 to 17 (JAVA8_TO_21_DEPENDENCY_UPDATES) -->
        <java.version>17</java.version>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
    </properties>

    <dependencies>
        <!-- Spring Boot Web Starter (includes embedded Tomcat with jakarta.servlet) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- Spring Boot JDBC Starter -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jdbc</artifactId>
        </dependency>

        <!-- Updated log4j-core from 2.14.1 (CVE-2021-44228 Log4Shell) to 2.23.1
             (JAVA8_TO_17_SPECIFIC_DEPENDENCY_UPDATES) — fixes critical security vulnerability
             and Java 17 module system incompatibility -->
        <dependency>
            <groupId>org.apache.logging.log4j</groupId>
            <artifactId>log4j-core</artifactId>
            <version>2.23.1</version>
        </dependency>

        <!-- Updated commons-collections from 3.2.1 (CVE-2015-6420 RCE via deserialization)
             to 3.2.2 (JAVA8_TO_17_DEPENDENCY_CONFLICTS) — fixes critical security vulnerability -->
        <dependency>
            <groupId>commons-collections</groupId>
            <artifactId>commons-collections</artifactId>
        <!-- PostgreSQL JDBC Driver — replaces H2 in-memory database for PostgreSQL 16 compatibility -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <version>42.7.3</version>
            <scope>runtime</scope>
        </dependency>

             (JAVA8_TO_21_JAKARTA_EE_MIGRATION): javax.servlet.* removed, replaced by jakarta.servlet.*
             Version managed by Spring Boot 3.2.5 parent BOM -->
        <dependency>
            <groupId>jakarta.servlet</groupId>
            <artifactId>jakarta.servlet-api</artifactId>
            <scope>provided</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Updated maven-compiler-plugin to 3.11.0 for Java 17 support
                 (JAVA8_TO_17_MAVEN_PLUGIN_UPDATES) — defaults were insufficient for Java 17 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.11.0</version>
                <configuration>
                    <source>17</source>
                    <target>17</target>
                    <release>17</release>
                </configuration>
            </plugin>

            <!-- Added maven-surefire-plugin 3.1.2 explicitly to prevent test failures on Java 17
                 (JAVA8_TO_17_MAVEN_PLUGIN_UPDATES) -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.1.2</version>
            </plugin>

            <!-- Spring Boot Maven Plugin for packaging -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>

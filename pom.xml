<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <!-- Updated from 2.7.15 to 3.2.5:
             Spring Boot 3.x is required for Java 17 compatibility.
             Spring Boot 2.7.x targets Java 8/11; Boot 3.x migrates to Jakarta EE 10
             (jakarta.*) and requires Java 17 as the minimum baseline. -->
        <version>3.2.5</version>
        <relativePath/>
    </parent>

    <groupId>com.demo</groupId>
    <artifactId>resortsLite</artifactId>
    <version>1.0.0</version>
    <name>ResortsLite</name>
    <!-- Updated description: removed Java 8 legacy baseline reference -->
    <description>Resort booking demo — Java 17 / Spring Boot 3.2.x</description>

    <properties>
        <!-- Updated from 1.8 to 17: sets javac --source/--target and enables
             Java 17 language features. Resolves: "Java version property set to 1.8" -->
        <java.version>17</java.version>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <maven.compiler.release>17</maven.compiler.release>
    </properties>

    <dependencies>
        <!-- Spring Boot Web Starter: version managed by spring-boot-starter-parent 3.2.5 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- Spring Boot JDBC Starter: version managed by spring-boot-starter-parent 3.2.5 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jdbc</artifactId>
        </dependency>

        <!-- Spring Boot Validation Starter: provides jakarta.validation.* support
             Required for Jakarta EE 10 validation annotations (replaces javax.validation.*) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- H2 in-memory database for development/testing -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- Spring Boot Test Starter: includes JUnit 5 (Jupiter) for Java 17 compatibility.
             JUnit 4 is NOT included — JUnit 5 is the standard for Spring Boot 3.x -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!--
            REMOVED DEPENDENCIES (security vulnerabilities):

            1. log4j-core 2.14.1 — CVE-2021-44228 Log4Shell critical RCE vulnerability.
               Spring Boot 3.x uses Logback/SLF4J by default; explicit log4j-core is not
               needed and was a critical security blocker for Java 17 upgrade.

            2. commons-collections 3.2.1 — CVE-2015-6420 remote code execution vulnerability.
               Spring Boot 3.x transitively pulls commons-collections 4.x which is not affected.

            3. mysql-connector-java (mysql group) — replaced by com.mysql:mysql-connector-j
               if MySQL is needed. Currently using H2 in-memory DB for this demo.

            4. thymeleaf-extras-java8time — not needed; Spring Boot 3.x / Thymeleaf 3.1+
               has built-in Java 8 time support without the extra dialect.
        -->
    </dependencies>

    <build>
        <plugins>
            <!-- Updated maven-compiler-plugin to 3.13.0:
                 Required for Java 17 compilation support. Older plugin versions (e.g. 3.7.0)
                 do not recognise --release 17 and fail with "invalid target release: 17".
                 Explicit source/target/release all set to 17. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <source>17</source>
                    <target>17</target>
                    <release>17</release>
                    <encoding>UTF-8</encoding>
                </configuration>
            </plugin>

            <!-- Spring Boot Maven Plugin: packages the application as an executable JAR -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>

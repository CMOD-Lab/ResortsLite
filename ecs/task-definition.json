{
  "family": "resortslite-task",
  "requiresCompatibilities": ["FARGATE"],
  "networkMode": "awsvpc",
  "cpu": "512",
  "memory": "1024",
  "executionRoleArn": "arn:aws:iam::{{ACCOUNT_ID}}:role/ecsTaskExecutionRole",
  "taskRoleArn": "arn:aws:iam::{{ACCOUNT_ID}}:role/ecsTaskRole",
  "containerDefinitions": [
    {
      "name": "resortslite",
      "image": "{{IMAGE_URI}}",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 8080,
          "protocol": "tcp"
        }
      ],
      "environment": [
        { "name": "SPRING_PROFILES_ACTIVE", "value": "docker" },
        { "name": "SERVER_PORT",            "value": "8080" },
        { "name": "TZ",                     "value": "UTC" },
        { "name": "JAVA_OPTS",              "value": "-Xms256m -Xmx512m -XX:+UseContainerSupport -XX:MaxRAMPercentage=75.0 -XX:+UseG1GC -Djava.security.egd=file:/dev/./urandom -Dfile.encoding=UTF-8 -Duser.timezone=UTC" },
        { "name": "REDIS_HOST",             "value": "{{REDIS_HOST}}" },
        { "name": "REDIS_PORT",             "value": "6379" },
        { "name": "PAYMENT_API_URL",        "value": "{{PAYMENT_API_URL}}" },
        { "name": "APP_PAYMENT_ENDPOINT",   "value": "{{APP_PAYMENT_ENDPOINT}}" },
        { "name": "APP_INVENTORY_ENDPOINT", "value": "{{APP_INVENTORY_ENDPOINT}}" },
        { "name": "APP_NOTIFICATION_ENDPOINT", "value": "{{APP_NOTIFICATION_ENDPOINT}}" },
        { "name": "REPORT_BASE_PATH",       "value": "/tmp/reports" },
        { "name": "BACKUP_PATH",            "value": "/tmp/backups" }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group":         "/ecs/resortslite",
          "awslogs-region":        "{{AWS_REGION}}",
          "awslogs-stream-prefix": "ecs"
        }
      }
    }
  ]
}
